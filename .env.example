# CX Sentiment & Churn Sentinel — example environment file
#
# Copy this file to `.env` and fill in real values on your own machine.
# `.env` is gitignored. Never commit a filled copy.
#
#   cp .env.example .env
#
# Every value below is a placeholder. None of them is a working credential.

# --- Data warehouse (read-only access expected) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ops_db
DB_USER=readonly_user
DB_PASS=change-me

# Full connection string alternative, if your driver needs one
DW_CONNECTION_STRING=postgresql://username:password@localhost:5432/datawarehouse

# --- Alerting ---
# Create your own incoming webhook and paste it here.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME

# --- Outputs ---
BI_OUTPUT_PATH=output/bi
